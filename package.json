{
    "name": "av-grid",
    "version": "2.4.0",
    "description": "Framework-agnostic virtualized data grid for the DOM. No dependencies. Built for 100k+ rows.",
    "license": "MIT",
    "author": "Andriy Viyatyk (https://github.com/andriy-viyatyk)",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/andriy-viyatyk/av-grid.git"
    },
    "homepage": "https://github.com/andriy-viyatyk/av-grid#readme",
    "bugs": {
        "url": "https://github.com/andriy-viyatyk/av-grid/issues"
    },
    "type": "module",
    "main": "./dist/av-grid.umd.cjs",
    "module": "./dist/av-grid.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/av-grid.js",
            "require": "./dist/av-grid.umd.cjs"
        },
        "./react": {
            "types": "./dist/react/index.d.ts",
            "import": "./dist/react.js"
        },
        "./av-grid.css": "./dist/av-grid.css"
    },
    "files": [
        "dist"
    ],
    "peerDependencies": {
        "react": ">=18",
        "react-dom": ">=18"
    },
    "peerDependenciesMeta": {
        "react": {
            "optional": true
        },
        "react-dom": {
            "optional": true
        }
    },
    "keywords": [
        "grid",
        "datagrid",
        "table",
        "virtualized",
        "virtual-scroll",
        "vanilla-js",
        "typescript"
    ],
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build && vite build -c vite.config.react.ts && tsc -p tsconfig.build.json && node scripts/build-css.mjs",
        "build:board": "npm run build:board:render && npm run build:board:grid && npm run build:board:custom",
        "build:board:render": "vite build --outDir test-boards/RenderGridTest/lib --emptyOutDir false",
        "build:board:grid": "vite build --outDir test-boards/AVGridBoard/lib --emptyOutDir false",
        "build:board:custom": "vite build --outDir test-boards/CustomizationBoard/lib --emptyOutDir false",
        "typecheck": "tsc --noEmit",
        "version": "node scripts/sync-version.mjs && git add src/AVGrid.ts src/index.ts",
        "prepublishOnly": "npm run build",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "devDependencies": {
        "@testing-library/react": "^16.3.3",
        "@types/node": "^26.2.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.5",
        "happy-dom": "^20.11.2",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "typescript": "^5.4.0",
        "vite": "^8.1.4",
        "vitest": "^3.0.0"
    }
}
