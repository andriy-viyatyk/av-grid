{
    "name": "av-grid",
    "version": "0.0.0",
    "description": "Framework-agnostic virtualized data grid for the DOM. No dependencies. Built for 100k+ rows.",
    "license": "MIT",
    "type": "module",
    "main": "./dist/av-grid.umd.cjs",
    "module": "./dist/av-grid.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/av-grid.js",
            "require": "./dist/av-grid.umd.cjs"
        },
        "./av-grid.css": "./dist/av-grid.css"
    },
    "files": [
        "dist"
    ],
    "keywords": [
        "grid",
        "datagrid",
        "table",
        "virtualized",
        "virtual-scroll",
        "vanilla-js",
        "typescript"
    ],
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "devDependencies": {
        "@types/node": "^26.2.0",
        "typescript": "^5.4.0",
        "vite": "^8.1.4",
        "vitest": "^3.0.0"
    }
}
